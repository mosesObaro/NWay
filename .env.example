# Copy to .env (gitignored). Secrets live ONLY here -- never in YAML, never in
# the database, and they are redacted from logs.

NWAY_FOOTBALL_DATA_ORG_TOKEN=your_free_token_from_football-data.org
NWAY_CONTACT_EMAIL=you@example.com          # sent in the User-Agent, as a courtesy

# Email delivery. Resend is the configured provider (config/notifications.yaml).
# The sender domain must be verified in your Resend dashboard; until it is,
# Resend only accepts the onboarding sender and your own account address.
NWAY_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NWAY_EMAIL_FROM=NWay Predictions <predictions@yourdomain.com>
NWAY_EMAIL_TO=you@example.com
NWAY_EMAIL_REPLY_TO=

# Only needed if you switch config/notifications.yaml to provider: smtp
NWAY_SMTP_HOST=
NWAY_SMTP_PORT=587
NWAY_SMTP_USERNAME=
NWAY_SMTP_PASSWORD=

NWAY_DATABASE_URL=sqlite:///data/nway.db
NWAY_LOG_LEVEL=INFO
